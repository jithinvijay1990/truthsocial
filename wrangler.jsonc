{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "truthsocial",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "truthsocial-db",
      "database_id": "9ed14dfd-4ec1-4815-9bb3-82bb5d538842",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "FEED_URLS": "https://trumpstruth.org/feed",
    "ALERT_ALL_POSTS": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
