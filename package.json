{
  "name": "truthsocial",
  "version": "1.0.0",
  "description": "Polls Trump's Truth Social posts via RSS and alerts Telegram on market-relevant keywords (tariffs, China, the Fed, etc).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply truthsocial-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply truthsocial-db --remote",
    "poll:local": "curl -X POST http://localhost:8787/api/poll"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.110.0"
  }
}
